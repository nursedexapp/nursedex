{
  "name": "nursedex",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "clean": "tsx scripts/clean.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:auth": "E2E_AUTH=1 playwright test",
    "test:health": "vitest run --config vitest.health.config.ts",
    "test:health:services": "vitest run --config vitest.health.config.ts src/lib/__tests__/posthog-health.test.ts src/lib/__tests__/posthog-ingestion-health.test.ts src/lib/__tests__/resend-health.test.ts src/lib/__tests__/sentry-health.test.ts src/lib/__tests__/skew-protection-health.test.ts src/lib/__tests__/supabase-health.test.ts",
    "test:rls": "vitest run --config vitest.health.config.ts src/lib/__tests__/rls-policies.test.ts src/lib/__tests__/rls-hardening.test.ts src/lib/__tests__/data-api-grants.test.ts src/lib/__tests__/routine-execute-grants.test.ts src/lib/__tests__/db-guards.test.ts src/lib/__tests__/rls-insert-shape.test.ts src/lib/__tests__/rls-with-check.test.ts src/lib/__tests__/nurse-identity-gating.test.ts",
    "test:rls:local": "./scripts/test-rls-local.sh",
    "test:guard-mutation": "tsx scripts/guard-mutation.ts",
    "smoke:prod": "npx supabase db query --linked --output-format json \"$(cat scripts/prod-smoke.sql)\" | tsx scripts/check-prod-smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
