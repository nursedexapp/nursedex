# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Shared secret for the Supabase Auth "Send Email Hook" (Standard Webhooks).
# Set the same value here and in Supabase Dashboard > Authentication > Hooks.
SUPABASE_AUTH_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_NURSE_FEATURED_PRICE_ID=
STRIPE_FAMILY_ACCESS_PRICE_ID=
# Annual Family Access ($99/yr recurring price) and the first-year promo
# coupon ($99 -> $39.99, duration "once").
STRIPE_FAMILY_ACCESS_ANNUAL_PRICE_ID=
STRIPE_FAMILY_ACCESS_ANNUAL_COUPON_ID=

# Resend (email)
RESEND_API_KEY=

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
# Server-side reads (admin blog view counts). Personal API key + project id;
# API host defaults to https://us.posthog.com when unset.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=

# Sentry (error tracking)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Cloudflare Turnstile (CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# App
CRON_SECRET=
SITE_PASSWORD=
